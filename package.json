{
  "name": "trade-foundry",
  "version": "0.1.0",
  "private": true,
  "description": "An AutoResearch loop that drives a coding agent to discover and falsify deterministic trading strategies under walk-forward evaluation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rp7o/trade-foundry.git"
  },
  "keywords": [
    "autoresearch",
    "trading-strategy",
    "backtesting",
    "walk-forward",
    "agent"
  ],
  "packageManager": "pnpm@12.4.2",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "postinstall": "node scripts/init-local.mjs",
    "init:local": "node scripts/init-local.mjs",
    "setup": "tsx scripts/setup.ts",
    "workspace": "node scripts/workspace.mjs",
    "research:refresh": "node scripts/workspace.mjs run tsx scripts/refresh-research.ts",
    "research:loop": "node scripts/workspace.mjs run tsx src/cli.ts loop",
    "test:timesfm": "python3 -m unittest discover -s test -p 'test_timesfm_*.py'",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "ar": "node scripts/workspace.mjs run tsx src/cli.ts",
    "cleanup": "node scripts/workspace.mjs run tsx scripts/cleanup.ts",
    "eval": "node scripts/workspace.mjs run tsx research/trade-long/eval.ts",
    "falsify": "node scripts/workspace.mjs run tsx research/trade-long/falsify.ts",
    "portfolio:diagnose": "node scripts/workspace.mjs run tsx research/trade-long/diagnose-portfolio.ts",
    "strategy:check": "node scripts/workspace.mjs run tsc --noEmit -p tsconfig.strategy.json",
    "strategy:contract": "node scripts/workspace.mjs run tsx scripts/strategy-contract.ts",
    "strategy:shared-contract": "node scripts/workspace.mjs run tsx research/engine/strategy-contract.ts research/trade-long/strategy.ts",
    "strategy:premise": "node scripts/workspace.mjs run tsx research/trade-long/premise-contract.ts",
    "strategy:signal-screen": "node scripts/workspace.mjs run tsx research/trade-long/hooks/signal-screen.ts",
    "archive": "git archive --format=tar.gz -o trade-foundry.tar.gz HEAD",
    "market:import": "node scripts/workspace.mjs run tsx scripts/market-data.ts import",
    "market:sync-local": "node scripts/workspace.mjs run tsx scripts/sync-market-data.ts",
    "market:status": "node scripts/workspace.mjs run tsx scripts/market-data.ts status",
    "market:select-universe": "node scripts/workspace.mjs run tsx scripts/select-universe.ts",
    "generate-training": "node scripts/workspace.mjs run tsx scripts/generate-training-data.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
